{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Owned by the API host. Public; no identity, permission or organization/site scope required. No inputs. Does not check database readiness or business access.",
        "operationId": "getProcessHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API process responds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected host failure; no internal details are exposed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Check API process liveness",
        "tags": [
          "Host"
        ]
      }
    }
  },
  "info": {
    "title": "IOP local API host",
    "description": "Process liveness only. No business operations or database readiness.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer into the documented request representation; empty means the whole request.",
            "maxLength": 256
          },
          "code": {
            "type": "string",
            "enum": [
              "required",
              "invalid",
              "out-of-range",
              "unsupported"
            ]
          }
        },
        "required": [
          "pointer",
          "code"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:iop:problem:bad-request",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "traceId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated error occurrence identifier; not a client-supplied ID."
          },
          "errors": {
            "maxItems": 50,
            "description": "Only present for explicit safe input validation failures (400).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "traceId"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
