# Compose only; ignored .env must contain a locally generated password.
# Empty fails closed. Never use a production credential.
IOP_POSTGRES_PASSWORD=

# API scope is loaded from config/poc.local.json (read-only Compose mount).
# Native npm startup uses IOP_CONFIG_FILE; it does not load this .env file.

# Optional database tooling overlay. Generate separate local passwords (16–256 bytes).
# Required only when loading compose.database.yaml; never passed to API/web.
IOP_MIGRATOR_PASSWORD=
IOP_RUNTIME_PASSWORD=
