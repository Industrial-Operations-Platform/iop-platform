# Allow only build inputs; local configuration/data never enters the context.
**
!package.json
!package-lock.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig*.json
!apps/api/src/
!apps/api/src/**
!apps/api/Dockerfile
!apps/web/
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!apps/web/Dockerfile
!apps/web/nginx.conf
!infra/
!infra/database/
!infra/database/Dockerfile
!infra/database/tsconfig.json
!infra/database/*.ts
!infra/database/migrations/
!infra/database/migrations/*.sql

# Exclude private files even when placed inside an allowed source directory.
**/.env
**/.env.*
**/*.local.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
!infra/local/
!infra/local/Dockerfile
!scripts/
!scripts/local/
!scripts/local/initialize.cjs
!scripts/local/bootstrap-access.cjs
!scripts/local/locator-private-copy.cjs
!apps/web/public/
!apps/web/public/**
!apps/web/jest.config.cjs
!apps/web/test/
!apps/web/test/design-boundaries.spec.ts
!scripts/local/jobs.cjs
!scripts/local/workforce-demo.cjs
!scripts/local/asset-domain-demo-runner.cjs
!infra/operations/
!infra/operations/audit-operator.cjs
!infra/railway/
!infra/railway/Dockerfile
!infra/railway/entrypoint.sh
!infra/railway/revision.json
!scripts/railway/
!scripts/railway/*.cjs

# Keep these final: public/source allowlists must never re-include private material.
**/.env
**/.env.*
**/*.local.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
